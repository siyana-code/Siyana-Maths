APP_ENV=development
API_VERSION=0.1.0

# Supabase project settings. Leave blank locally until the project is created.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_TIMEOUT_SECONDS=5.0

# Comma-separated exact browser origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
